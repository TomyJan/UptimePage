# Reference only. Set actual keys in EdgeOne server-side function variables.
# Build scripts do not automatically load .env files.
PEEKAPING_API_KEY=replace-in-edgeone-console
UPTIMEROBOT_API_KEY=replace-in-edgeone-console

# Optional build / verification variables (set in the build environment or shell).
# Without UPTIMEPAGE_CONFIG, use config/site.json if present, otherwise config/default.json.
# UPTIMEPAGE_CONFIG=config/site.local.json
# UPTIMEPAGE_COMMIT=full-git-commit-hash
# UPTIMEPAGE_PREVIEW_URL=https://your-preview.example.com
# UPTIMEPAGE_CONFIG_EDITOR=true
# Optional build-only editor. Rebuild, then visit /?configeditor=on.
# Omit or set false to exclude the editor from the build.

# KV is a platform namespace binding, not a text environment variable.
# Configure cache.kvBinding in JSON with its binding name if you use KV.
