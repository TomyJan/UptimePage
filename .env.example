# Reference only; build scripts do not automatically load .env files.
# Deployment: docs/deployment.md. Configuration: docs/configuration.md.

# Function runtime: actual keys belong in EdgeOne function environment variables.
# Names must match source.apiKeyEnv in your configuration.
PEEKAPING_API_KEY=replace-in-edgeone-console
UPTIMEROBOT_API_KEY=replace-in-edgeone-console

# Build: explicit path overrides config/site.json, then config/default.json.
# UPTIMEPAGE_CONFIG=config/site.local.json
# UPTIMEPAGE_COMMIT=full-git-commit-hash

# Optional editor: exactly true includes it in the build; omitted/false excludes it.
# Rebuild, then visit /?configeditor=on. Without the query, the site uses real data.
# UPTIMEPAGE_CONFIG_EDITOR=true

# Local deployment verification: HTTPS origin, no path or query.
# UPTIMEPAGE_PREVIEW_URL=https://your-preview.example.com

# KV is a project resource binding, not a text environment variable.
# Bind a namespace and set cache.kvBinding to the binding variable name.
