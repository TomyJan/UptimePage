{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "erasableSyntaxOnly": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "config",
    "scripts",
    "tests",
    "edge-functions",
    "cloud-functions",
    "*.config.ts",
    ".generated/public-config.ts",
    ".generated/server-config.ts"
  ]
}
