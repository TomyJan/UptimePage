{
  "name": "uptimepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate": "node scripts/build-config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "npm run generate && vite",
    "dev:demo": "npm run generate && node scripts/dev-demo.mjs",
    "build": "npm run generate && npm run typecheck && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "verify:public-build": "node scripts/verify-public-build.ts",
    "format": "prettier --write src config scripts tests *.ts *.json index.html",
    "format:check": "prettier --check src config scripts tests *.ts *.json index.html"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.104.5",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
