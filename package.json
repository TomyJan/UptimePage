{
  "name": "uptimepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "^22.18.0"
  },
  "scripts": {
    "generate": "node scripts/build-config.ts",
    "typecheck": "pnpm run generate && tsc --noEmit",
    "test": "node scripts/test.mjs unit",
    "dev": "pnpm run generate && vite",
    "dev:demo": "pnpm run generate && node scripts/dev-demo.mjs",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "test:e2e": "node scripts/test.mjs browser",
    "test:editor": "node scripts/test.mjs editor",
    "verify:public-build": "node scripts/verify-public-build.ts",
    "verify:deployment": "pnpm run build && node scripts/verify-deployment.ts",
    "verify:browser": "pnpm run generate && playwright test --config=playwright.deployment.config.ts",
    "format": "prettier --write README.md docs src config scripts tests edge-functions cloud-functions .github *.ts *.json *.yaml index.html",
    "format:check": "prettier --check README.md docs src config scripts tests edge-functions cloud-functions .github *.ts *.json *.yaml index.html"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.105.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
